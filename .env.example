# Existing MongoDB server. The application uses a NEW database named seo_monitor.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=seo_monitor
ENSURE_INDEXES=true
DOMAINS_FILE=domains.json
CERTIFICATE_DOMAINS_FILE=certificate_domains.json

HTTP_ADDR=127.0.0.1:10001

# Set a long random token before exposing the API publicly.
API_TOKEN=change-this-to-a-long-random-token
CORS_ALLOWED_ORIGINS=http://localhost:3000

SOURCE_BASE_URL=https://seo.chinaz.com
SOURCE_DATA_URL=https://othertool.chinaz.com
SCRAPE_USER_AGENT="seo-monitor/1.0 (daily metrics collector; contact your administrator)"
SCRAPE_TIMEOUT=25s
SCRAPE_MIN_DELAY=3s
SCRAPE_MAX_DELAY=8s
SCRAPE_RETRIES=3
MAX_RESPONSE_BYTES=3145728

# One worker is intentionally conservative for the upstream site.
WORKER_COUNT=1
JOB_POLL_INTERVAL=2s
STALE_JOB_AFTER=20m
# Keep today plus this many preceding calendar dates in metrics and job logs.
RETENTION_DAYS=60
SNAPSHOT_TIMEZONE=Asia/Shanghai
COLLECT_CRON="15 2 * * *"
QUEUE_ON_START=true

# TLS certificate checks run on startup and then on this schedule.
CERTIFICATE_WORKERS=10
CERTIFICATE_TIMEOUT=8s
CERTIFICATE_CRON="45 3 * * *"
# Keep recent polling records for this many preceding calendar dates. If all
# recent checks fail, the latest successful window is protected as a fallback.
CERTIFICATE_RETENTION_DAYS=7
# Optional comma-separated Agent base URLs, for example:
# http://10.0.1.10:8002,http://10.0.2.10:8002
# Master checks locally first and only sends local failures to these nodes.
CERTIFICATE_AGENT_URLS=
CERTIFICATE_AGENT_TOKEN=
CERTIFICATE_AGENT_TIMEOUT=15s
CERTIFICATE_AGENT_MAX_CONCURRENT=4
